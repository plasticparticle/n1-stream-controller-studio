{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "N1 Stream Controller Studio",
  "version": "0.1.0",
  "identifier": "com.plasticparticle.n1-stream-controller-studio",
  "build": {
    "beforeDevCommand": "npm run native:prepare",
    "beforeBuildCommand": "npm run native:prepare",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "N1 Stream Controller Studio",
        "width": 1600,
        "height": 1000,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "externalBin": [
      "binaries/n1-driver"
    ],
    "linux": {
      "deb": {
        "recommends": [
          "wmctrl",
          "xdotool"
        ]
      }
    }
  }
}
